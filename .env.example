# ====== DISCORD CONFIG ======
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=put_your_bot_token_here

# Bot Application (Client) ID — from the "General Information" page
DISCORD_CLIENT_ID=put_your_client_id_here

# ====== WEB CONFIG ======
# Port for the web interface
PORT=3000

# Bind address. Leave empty for local dev. On a VPS behind Nginx, set HOST=127.0.0.1
# so the app can't be reached directly from outside.
# HOST=127.0.0.1

# Password to access the web interface (REQUIRED when hosting on a public VPS).
# If left empty, the web interface can be accessed WITHOUT a password (local use only).
WEB_PASSWORD=change_this_password

# ====== OPTIONAL ======
# Max upload file size in MB
MAX_UPLOAD_MB=8

# Soundboard output volume (0.3 = 30%). Range 0–2 (200%).
OUTPUT_VOLUME=0.3

# Discord chat command prefix (e.g. "sb!").
COMMAND_PREFIX=sb!

# Idle minutes before the bot auto-leaves voice (chat-command sessions).
IDLE_TIMEOUT_MIN=5
