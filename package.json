{
  "name": "discord-web-soundboard",
  "version": "1.0.0",
  "description": "Discord soundboard bot controlled from a web interface and chat commands. The bot stays in a voice channel and plays sounds on demand.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node src/registerCommands.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.1.1",
    "@snazzah/davey": "^0.1.9",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.2.0",
    "multer": "^1.4.5-lts.1",
    "opusscript": "^0.1.1",
    "ws": "^8.18.0"
  }
}
